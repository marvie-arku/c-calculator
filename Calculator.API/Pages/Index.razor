@page "/blazor"
@using global::Calculator.API.Services
@using System.Text.Json
@inject ICalculatorService CalculatorService
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Simple Calculator</PageTitle>

<div class="calculator-container">
    <h1>Simple Calculator</h1>
    
    <div class="toggle-container">
        <label class="toggle-label">
            <span>Calculation Mode:</span>
            <div class="toggle-switch">
                <input type="checkbox" checked="@useFrontendCalculation" @onchange="@((ChangeEventArgs e) => useFrontendCalculation = (bool)(e.Value ?? false))" />
                <span class="toggle-slider"></span>
            </div>
            <span class="toggle-text">@(useFrontendCalculation ? "Frontend" : "Backend")</span>
        </label>
    </div>
    
    <div class="display">
        @if (isLoading)
        {
            <text>Calculating...</text>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <text>Error</text>
        }
        else
        {
            <text>@displayValue</text>
        }
    </div>
    
    <div class="input-group">
        <label for="numberA">First Number:</label>
        <input type="number" @bind="numberA" @bind:event="oninput" id="numberA" step="any" placeholder="Enter first number" disabled="@isLoading" />
    </div>
    
    <div class="input-group">
        <label for="numberB">Second Number:</label>
        <input type="number" @bind="numberB" @bind:event="oninput" id="numberB" step="any" placeholder="Enter second number" disabled="@isLoading" />
    </div>
    
    <div class="buttons">
        <button class="btn-add" @onclick="@(() => Calculate("add"))" disabled="@isLoading">
            + Add
        </button>
        <button class="btn-subtract" @onclick="@(() => Calculate("subtract"))" disabled="@isLoading">
            − Subtract
        </button>
        <button class="btn-multiply" @onclick="@(() => Calculate("multiply"))" disabled="@isLoading">
            × Multiply
        </button>
        <button class="btn-divide" @onclick="@(() => Calculate("divide"))" disabled="@isLoading">
            ÷ Divide
        </button>
    </div>
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error show">
            @errorMessage
        </div>
    }
</div>

@code {
    private double? numberA;
    private double? numberB;
    private double displayValue = 0;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool useFrontendCalculation = true; // Default to frontend for offline capability

    private async Task Calculate(string operation)
    {
        if (!numberA.HasValue || !numberB.HasValue)
        {
            errorMessage = "Please enter valid numbers";
            await Task.Delay(5000);
            errorMessage = string.Empty;
            return;
        }

        errorMessage = string.Empty;
        isLoading = true;
        
        try
        {
            double result;
            
            if (useFrontendCalculation)
            {
                // Frontend calculation - works offline, no API call needed
                result = await CalculateFrontend(operation);
            }
            else
            {
                // Backend calculation - calls API
                result = await CalculateBackend(operation);
            }
            
            displayValue = result;
        }
        catch (DivideByZeroException ex)
        {
            errorMessage = ex.Message;
            displayValue = 0;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Failed to connect to the server. Try using Frontend mode for offline calculation.";
            displayValue = 0;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            displayValue = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task<double> CalculateFrontend(string operation)
    {
        // Pure frontend calculation - no API calls, works offline
        double result = operation switch
        {
            "add" => numberA!.Value + numberB!.Value,
            "subtract" => numberA!.Value - numberB!.Value,
            "multiply" => numberA!.Value * numberB!.Value,
            "divide" => numberB!.Value == 0 
                ? throw new DivideByZeroException("Cannot divide by zero") 
                : numberA!.Value / numberB!.Value,
            _ => throw new ArgumentException("Invalid operation")
        };
        
        return Task.FromResult(result);
    }

    private async Task<double> CalculateBackend(string operation)
    {
        // Backend calculation via API
        var httpClient = HttpClientFactory.CreateClient();
        var request = new
        {
            a = numberA!.Value,
            b = numberB!.Value
        };

        var json = JsonSerializer.Serialize(request);
        var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
        
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        var apiUrl = $"{baseUri}/api/calculator/{operation}";
        var response = await httpClient.PostAsync(apiUrl, content);
        var responseContent = await response.Content.ReadAsStringAsync();

        if (response.IsSuccessStatusCode)
        {
            var result = JsonSerializer.Deserialize<CalculationResponse>(responseContent, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
            
            return result!.Result;
        }
        else
        {
            var error = JsonSerializer.Deserialize<ErrorResponse>(responseContent, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
            
            throw new Exception(error?.Error ?? "An error occurred");
        }
    }

    private class CalculationResponse
    {
        public double Result { get; set; }
    }

    private class ErrorResponse
    {
        public string? Error { get; set; }
    }
}
